    <selectionEntry name="Ordnance Wave" id="d0b65bfa-2fc4-4c1b-ab8f-a2086f0fff3c" collective="false" hidden="true" import="true" page="91" publicationId="1bc8-5968-21c3-0f27" type="upgrade">
      <categoryLinks>
        <categoryLink name="Special" id="d0b65bfa-2fc4-4c1b-ab8f-a2086f0fff3c-5370656369616c23232344415441232323" hidden="false" primary="false" targetId="5370656369616c23232344415441232323"/>
        <categoryLink name="Ordnance" id="d687-5fbe-95a9-ecbd" hidden="false" primary="true" targetId="e70d-1bf2-7ea2-276a"/>
      </categoryLinks>
      <constraints>
        <constraint id="eda9-5b43-f5b5-f059" field="points" includeChildForces="false" includeChildSelections="false" percentValue="true" scope="force" shared="true" type="max" value="10"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="7529-da04-0225-31de" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
                <condition childId="bf37-f25f-be0e-e317" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Ordnance Wave" id="9226-04b7-a78b-e223" hidden="false">
          <description>Up to 10% of the fleet’s points allowance may be spent on Ordnance markers as long as at least one hive ship is chosen.

Ordnance may be formed up into waves which are treated as squadrons for the purposes of deployment. In a campaign, ordnance does not form a permanent part of the fleet and is ‘used up’ in a battle.</description>
        </rule>
      </rules>
