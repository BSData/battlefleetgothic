      <profiles>
        <profile name="Sorcerous Fleet of Tzeentch" id="84e5-3b58-dc20-cdbb" hidden="false" typeId="5a49-6569-78e9-a35c" typeName="Special Rule">
          <characteristics>
            <characteristic name="Effects" typeId="fe13-6bab-c5cb-4f1d">Chaos Warmaster must take the mark of Tzeentch. And Chaos Lords may only take the mark of Tzeentch.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </forceEntry>
